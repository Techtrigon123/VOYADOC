# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase → Project Settings → API. The service-role key is SERVER-ONLY:
# never prefix it with NEXT_PUBLIC_ and never expose it to the browser.
# Create the tables once by running supabase/migrations/0001_init.sql in the SQL Editor.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# REQUIRED, at least 32 characters. The app refuses to start sessions without it.
JWT_SECRET=

# ─── Razorpay (Payments) ──────────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Sentry (Optional Monitoring) ────────────────────────────────────────────
# Get from https://sentry.io
# SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx

# ─── Agent panel: plan upgrades (UPI) ─────────────────────────────────────────
# The Pricing → Choose Gold/Platinum popup builds a UPI QR from these.
# Leave unset to show "payment details not configured".
PLAN_PAYMENT_UPI_ID=yourbusiness@upi
PLAN_PAYMENT_PAYEE_NAME=Voyenta

# ─── Agent panel: upload auto-fill (hotel voucher / air ticket) ──────────────
# Reads uploaded PDFs/photos with Claude and fills the form. Leave unset to
# show "Upload auto-fill is not available right now" (manual entry still works).
# ANTHROPIC_API_KEY=sk-ant-...

# ── AI cost controls (upload auto-fill) ──────────────────────────────
# Requires supabase/migrations/0004_ai_cost_controls.sql. Without it, AI calls are refused (fail closed).
# Kill switch: set to false to turn upload auto-fill off instantly.
AI_EXTRACT_ENABLED=true
# Hard spend ceilings for all AI calls together, in USD. Calls pause when reached.
AI_DAILY_BUDGET_USD=10
AI_MONTHLY_BUDGET_USD=150
# Fair-use cap per account per day, on every plan (including Platinum "unlimited").
AI_USER_DAILY_LIMIT=30
# Shared daily pool for all free (Silver) accounts together.
AI_FREE_POOL_DAILY_LIMIT=100
# Largest PDF sent to the model, in pages.
AI_MAX_PDF_PAGES=5

# ── Live chat (Chatwoot) ────────────────────────────────────────────────
# Website inbox token: Chatwoot → Settings → Inboxes → (your website inbox) → Configuration.
# Leave empty to hide the chat bubble.
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=
# Only if you self-host Chatwoot; defaults to https://app.chatwoot.com
NEXT_PUBLIC_CHATWOOT_BASE_URL=
# Optional, server-only: Inbox → Configuration → Identity validation → HMAC token.
# Stops people from opening a chat while pretending to be another agent. Never prefix with NEXT_PUBLIC_.
CHATWOOT_HMAC_TOKEN=
